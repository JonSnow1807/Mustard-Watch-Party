# Database Configuration
DATABASE_URL=postgresql://username:password@host:5432/dbname
DB_NAME=your_database_name

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Application Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your-secret-key-here
JWT_EXPIRES_IN=7d

# Frontend URL (for CORS). Comma-separated allowlist; the FIRST entry is
# also where OAuth sends the browser back, so keep the real site first.
FRONTEND_URL=http://localhost:3001

# This API's own public origin, used to build the OAuth redirect_uri
PUBLIC_API_URL=http://localhost:3000

# Google sign-in (optional). Leave both blank and the provider is not
# offered at all: /auth/providers reports it off and the button never
# renders. Password auth is unaffected either way.
# Authorised redirect URI: ${PUBLIC_API_URL}/api/auth/google/callback
# NOTE: outside NODE_ENV=development/test these are ALSO ignored unless
# FRONTEND_URL is set to a non-loopback origin - see docs/AUTH.md.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session Configuration
SESSION_SECRET=your-session-secret-here
