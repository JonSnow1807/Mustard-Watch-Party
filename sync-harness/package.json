{
  "name": "sync-harness",
  "version": "0.1.0",
  "private": true,
  "description": "Measurement harness for Mustard Watch Party: drives N real browsers through scripted watch-party scenarios under network impairment and reports cross-client playback drift distributions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "scenario": "tsx src/run-scenario.ts",
    "matrix": "tsx src/run-scenario.ts S0,S1,S2,S3,S4,S5,S6,S7",
    "report": "tsx src/report-only.ts",
    "bots": "tsx src/bots/run-bots.ts"
  },
  "dependencies": {
    "playwright": "^1.49.0",
    "serve": "^14.2.4",
    "socket.io-client": "^4.8.1",
    "tsx": "^4.19.0",
    "vega": "^5.30.0",
    "vega-lite": "^5.21.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "typescript": "^5.7.0"
  }
}