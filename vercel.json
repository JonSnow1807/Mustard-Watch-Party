{
  "services": {
    "mustard-watch-party-backend": {
      "root": "video-sync-backend",
      "entrypoint": "src/main.ts",
      "buildCommand": "npm ci --include=dev && npm run build"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "type": "service",
        "service": "mustard-watch-party-backend"
      }
    }
  ]
}
